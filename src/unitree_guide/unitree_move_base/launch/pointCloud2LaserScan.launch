<launch>
    <!-- Mid-360 3D LiDAR PointCloud2 转 LaserScan -->
    <node pkg="pointcloud_to_laserscan" type="pointcloud_to_laserscan_node" name="mid360_pointcloud_to_laserscan" 
        respawn="false" output="screen">
        <remap from="cloud_in" to="/livox_lidar"/>
        <remap from="/scan" to="/scan"/>
        <rosparam>
            target_frame: base
            transform_tolerance: 0.01
            # 高度裁剪：只保留腿部和身体附近的点
            min_height: -0.25
            max_height: 0.5

            # Mid-360 360° 水平视场角
            angle_min: -3.14159
            angle_max: 3.14159
            angle_increment: 0.0087  # ~0.5° 分辨率
            scan_time: 0.1           # 10Hz
            range_min: 0.1
            range_max: 30.0
            use_inf: true

            # Concurrency level, affects number of pointclouds queued for processing and number of threads used
            # 0 : Detect number of cores
            # 1 : Single threaded
            # 2->inf : Parallelism level
            concurrency_level: 1
        </rosparam>
        <!-- <rosparam file="$(find unitree_move_base)/config/pointCloud_to_laserScan_params.yaml" command="load" /> -->
    </node>

</launch>